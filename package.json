{
  "name": "klarity",
  "version": "0.1.0",
  "description": "Open-source desktop GUI for Apache Kafka — browse, decode, operate, load-test.",
  "author": "Klarity contributors",
  "homepage": "https://github.com/devanshu0409/klarity",
  "main": "./out/main/index.js",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:norestart": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:local": "node scripts/pack-local.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "lucide-react": "^1.33.0",
    "lz4js": "^0.2.0",
    "monaco-editor": "^0.56.0",
    "protobufjs": "^8.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
